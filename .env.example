# co-docs-watcher — the container environment.
#
#   cp .env.example .env
#
# Schedules live here; windows live in config.toml — the same config.toml a hand-run reads,
# mounted into the container rather than copied into one of its own. The two answer different
# questions — how often to look, and how far back — and a cadence change must not read like
# a coverage change.
#
# There is no TZ here. source.timezone in config.toml is the project's only declaration of a
# zone, and the entrypoint exports TZ from it.

# --- the image ---------------------------------------------------------------------------
#
# Published to ghcr.io
IMAGE_TAG=latest

# --- the two profiles --------------------------------------------------------------------
#
# The monitor:
MONITOR_SCHEDULE=0 0,9-23 * * *
MONITOR_ENABLED=true

# The full sweep:
SWEEP_SCHEDULE=0 8 * * *
SWEEP_ENABLED=true

# Disabling either profile omits its crontab line. Disabling the sweep leaves the staleness
# warning firing on every run: giving up the older days is allowed, silently giving them up
# is not.

# --- the catch-up ------------------------------------------------------------------------
#
# sweep | monitor | none. A container start usually follows a restart, an update or downtime
# — the gap case exactly — so the catch-up is the full sweep: the monitor would re-observe
# the two days that were never in doubt and leave the gap open until 05:10.
RUN_ON_START=sweep

# --- process identity --------------------------------------------------------------------
#
# The uid and gid the watcher runs as, and therefore the owner of everything it writes. The
# modes are declared in [files]; this is who they apply to. The three mounted directories
# below must already be writable by this identity — the entrypoint never chowns a mount, as
# a mount whose owner is wrong is a decision the operator has to see.
PUID=1000
PGID=1000

# --- the three roots on the host ---------------------------------------------------------
#
# The host side of the three mounts. The container side is not configured here and never
# repeats itself: config.toml names its roots relatively, so they resolve beside the file
# itself, under /watcher/var/ — which is where compose.yaml mounts these.
#
# DATA_ROOT must be a filesystem local to the host: it holds the SQLite manifest, and SQLite
# locking over SMB/NFS is unreliable. DOCUMENTS_ROOT is the one that belongs on the share —
# it is the archive, and being handed to people is its purpose.
DATA_ROOT=./var/data
DOCUMENTS_ROOT=./var/documents
LOGS_ROOT=./var/logs
