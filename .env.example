# co-docs-watcher — the container environment.
#
#   cp .env.example .env
#
# Schedules live here; windows live in config.toml, mounted into the container.

# --- the image ---------------------------------------------------------------------------
#
# Published to ghcr.io
IMAGE_TAG=latest

# --- the two profiles --------------------------------------------------------------------
#
# The monitor:
MONITOR_SCHEDULE=0 0,9-23 * * *
MONITOR_ENABLED=true

# The full sweep:
SWEEP_SCHEDULE=0 8 * * *
SWEEP_ENABLED=true

# Disabling either profile omits its crontab line; disabling the sweep leaves the staleness
# warning firing on every run.

# --- the catch-up ------------------------------------------------------------------------
#
# What a container start runs: sweep | monitor | none.
RUN_ON_START=sweep

# --- process identity --------------------------------------------------------------------
#
# The uid and gid the watcher runs as, and the owner of everything it writes. The three
# directories below must already be writable by it — a mount is never chowned.
PUID=1000
PGID=1000

# --- the three roots on the host ---------------------------------------------------------
#
# Mounted under /watcher/var/, where config.toml's relative roots resolve. DATA_ROOT holds
# the SQLite manifest and must be local to the host, never SMB/NFS; DOCUMENTS_ROOT is the
# one that goes on the share.
DATA_ROOT=./var/data
DOCUMENTS_ROOT=./var/documents
LOGS_ROOT=./var/logs
